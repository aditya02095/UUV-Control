}
DEF TANK RectangleArena {
  translation 0 0.5 -10000
  floorSize 20000 16000
  floorAppearance ThreadMetalPlate {
  }
  wallHeight 20000
  wallAppearance PBRAppearance {
    transparency 0.95
    emissiveColor 0.8 0.8 0.8
  }
}
DEF STILL_WATER Fluid {
  streamVelocity 0 0 -2.0
  density 1000
  children [
    DEF S Shape {
      appearance DEF WATER_APPEARANCE PBRAppearance {
        baseColor 0 0.501961 1
        transparency 0.8
        roughness 1.1102230246251565e-16
        metalness 0
      }
      geometry Box {
        size 20000 15500 20000
      }
    }
  ]
  boundingObject Pose {
    children [
      Box {
        size 20000 15500 20000
      }
    ]
  }
}
DEF DRONE_UUV_1 Robot {
  translation 0 1 0
  name "uuv1"
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 1 0 0
        roughness 0.4
        metalness 0.1
      }
      geometry Cylinder {
        height 5
      }
    }
    
    GPS
    {
      name "gps"
    }
    
    Emitter
    {
      name "emitter"
      channel 1
    }

    InertialUnit {
      name "imu"
    }
    
    DEF MOTOR_1 Propeller {
      shaftAxis 0 0 1
      centerOfThrust 0.4 0 1.4
      torqueConstants 0.01 0
      device RotationalMotor {
        name "motor_1"
        maxVelocity 20
        maxTorque 5
      }
    }
    DEF MOTOR_2 Propeller {
      shaftAxis 0 0 1
      centerOfThrust -0.4 0 1.4
      torqueConstants -0.01 0
      device RotationalMotor {
        name "motor_2"
        maxVelocity 20
        maxTorque 5
      }
    }
    DEF MOTOR_3 Propeller {
      shaftAxis 0 0 1
      centerOfThrust 0.8 0 1.4
      device RotationalMotor {
        name "motor_3"
        maxVelocity 20
        maxTorque 5
      }
    }
    Pose {
      translation 0.8 0 1.4
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.8
            roughness 0.3
            metalness 0.6
          }
          geometry Cylinder {
            height 0.3
            radius 0.08
            subdivision 16
          }
        }
      ]
    }
    DEF MOTOR_4 Propeller {
      shaftAxis 0 0 1
      centerOfThrust -0.8 0 1.4
      device RotationalMotor {
        name "motor_4"
        maxVelocity 20
        maxTorque 5
      }
    }
    Pose {
      translation -0.8 0 1.4
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.8
            roughness 0.3
            metalness 0.6
          }
          geometry Cylinder {
            height 0.3
            radius 0.08
            subdivision 16
          }
        }
      ]
    }
  ]
  boundingObject Pose {
    rotation 0 0 1 1.5708
    children [
      Cylinder {
        height 5
      }
    ]
  }
  physics Physics {
    mass 60
    damping Damping {
      angular 0.5
    }
  }
  controller "uuv1_controller"
  supervisor FALSE
  linearVelocity 0 0 1.5662753959306247e-162
}

DEF DRONE_UUV_2 Robot {
